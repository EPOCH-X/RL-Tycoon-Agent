{
  "_comment": "exp14_lategame_curriculum: exp11 계열 관측/보상 구조를 유지하고 late-game 운영 학습을 위해 목표 금액과 기간을 늘린다.",

  "algorithm": "MaskablePPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 4000000,
    "n_envs": 12,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.005,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [128, 128],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "_comment": "exp11과 동일한 shaping 유지",
    "take_order": 4.0,
    "serve_food": 20.0,
    "submit_kitchen": 6.0,
    "pickup_food": 6.0,
    "pickup_drink": 2.0,
    "serve_drink": 5.0,
    "customer_payment": 0.02,
    "lost_customer": -80.0,
    "wrong_table": -6.0,
    "buy_upgrade": 1.0,
    "no_upgrade": -0.01,
    "win": 180.0,
    "trash": -1.0
  },

  "game_overrides": {
    "_comment": "late-game 운영까지 보게 하기 위해 승리 조건과 기간을 늘린다",
    "target_money": 500,
    "day_limit": 14
  }
}
