{
  "_comment": "exp20_strict_upgrade_play_quality: exp19의 strict upgrade 구조를 유지하면서 즉각적인 서비스 품질과 운영 응답성을 회복하고, win 정렬은 보조적으로 강화한다.",

  "algorithm": "MaskablePPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 3500000,
    "n_envs": 12,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.006,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [128, 128],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "_comment": "서비스 루프 반응성을 높이고 멍한 대기/헛이동을 줄이며, strict upgrade 선택은 유지한다.",
