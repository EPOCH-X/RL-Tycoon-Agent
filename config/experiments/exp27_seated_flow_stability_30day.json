{
  "_comment": "exp27_seated_flow_stability_30day: exp26의 30일 strict-upgrade + trait heuristic + rating diagnostics를 유지하면서, seated customer의 주문-조리-서빙 흐름 안정화를 위해 관련 관측을 추가하고 service-chain reward를 아주 약하게만 조정한다.",

  "algorithm": "MaskablePPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 12000000,
    "n_envs": 8,
    "seed": 42,
    "eval_freq": 10000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.008,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [128, 128],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "_comment": "exp26의 보상 구조를 유지하되 seated flow 안정화를 위해 take_order/submit/pickup/serve를 아주 약하게만 올린다.",
    "take_order": 4.5,
    "serve_food": 19.0,
    "submit_kitchen": 6.5,
    "pickup_food": 6.5,
    "pickup_drink": 3.0,
    "serve_drink": 6.0,
    "customer_payment": 0.01,
    "lost_customer": -90.0,
    "wrong_table": -8.0,
    "buy_upgrade": 0.0,
    "no_upgrade": 0.0,
    "win": 220.0,
    "trash": -1.0,
    "trash_orphan": 0.0,
    "orphan_cleared": 0.5,
    "stale_carry_cleared": 1.5,
    "customer_waiting": -0.2,
    "waiting_customer_seated": 2.5,
    "waiting_customer_left": -16.0,
    "blocked_move": -0.05,
    "idle_penalty": -0.03,
    "time_penalty": -0.003,
    "food_unlock": 0.0,
    "game_end": 0.004,
    "net_profit_delta": 0.0,
    "rating_delta": 2.5,
    "final_score_delta": 0.03
  },

  "game_overrides": {
    "_comment": "기본 게임의 30일 플레이 기준으로 평가한다.",
    "target_money": 1500,
    "day_limit": 30
  },

  "env_options": {
    "_comment": "개별 업그레이드 선택만 학습하도록 기존 auto-buy shortcut은 차단한다.",
    "disable_auto_buy_action": true
  }
