{
  "_comment": "exp08_loose_interact_mask: exp07 관측과 보상을 유지하고 interact 마스크만 완화한다.",

  "algorithm": "MaskablePPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 1000000,
    "n_envs": 12,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.005,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [128, 128],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "_comment": "exp07_relpos_obs와 동일한 shaping 유지",
    "take_order": 4.0,
    "serve_food": 20.0,
    "submit_kitchen": 6.0,
    "pickup_food": 6.0,
    "pickup_drink": 2.0,
    "serve_drink": 5.0,
    "customer_payment": 0.02,
    "lost_customer": -80.0,
    "wrong_table": -6.0,
    "buy_upgrade": 1.0,
    "no_upgrade": -0.01,
    "win": 180.0,
    "trash": -1.0
  },

  "game_overrides": {
    "_comment": "exp07과 동일한 목표 유지",
    "target_money": 150,
    "day_limit": 8
  },

  "env_options": {
    "_comment": "strict 대신 loose: 방향 정렬이 안 되어도 interact 마스크를 열어준다",
    "interact_mask_mode": "loose"
  }
}
