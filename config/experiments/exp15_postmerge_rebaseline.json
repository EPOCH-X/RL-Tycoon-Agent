{
  "_comment": "exp15_postmerge_rebaseline: main merge 이후 환경/가격/평점 변경을 반영한 상태에서 exp11 계열을 다시 기준선으로 측정한다.",

  "algorithm": "MaskablePPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 1500000,
    "n_envs": 12,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.005,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [128, 128],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "_comment": "exp11 shaping 유지. main에서 추가된 이벤트는 비교 목적상 중립화한다.",
    "take_order": 4.0,
    "serve_food": 20.0,
    "submit_kitchen": 6.0,
    "pickup_food": 6.0,
    "pickup_drink": 2.0,
    "serve_drink": 5.0,
    "customer_payment": 0.02,
    "lost_customer": -80.0,
    "wrong_table": -6.0,
    "buy_upgrade": 1.0,
    "no_upgrade": -0.01,
    "win": 180.0,
    "trash": -1.0,
    "trash_orphan": 0.0,
    "orphan_cleared": 0.0,
    "stale_carry_cleared": 0.0,
    "customer_waiting": 0.0,
    "waiting_customer_seated": 0.0,
    "waiting_customer_left": 0.0,
    "blocked_move": 0.0,
    "idle_penalty": 0.0,
    "time_penalty": 0.0,
    "food_unlock": 0.0,
    "game_end": 0.0,
    "net_profit_delta": 0.0,
    "rating_delta": 0.0,
    "final_score_delta": 0.0
  },

  "game_overrides": {
    "_comment": "exp11과 같은 early-game 목표로 post-merge 성능을 재측정한다.",
    "target_money": 150,
    "day_limit": 8
  }
}
