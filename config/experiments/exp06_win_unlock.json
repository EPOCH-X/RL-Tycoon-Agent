{
  "_comment": "exp06_win_unlock: exp05 축을 유지하고 목표 금액만 더 낮춰 첫 승리 경험을 여는 실험",

  "algorithm": "MaskablePPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 1000000,
    "n_envs": 12,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.005,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [128, 128],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "_comment": "exp05_win_curriculum과 동일한 shaping 유지",
    "take_order": 4.0,
    "serve_food": 20.0,
    "submit_kitchen": 6.0,
    "pickup_food": 6.0,
    "pickup_drink": 2.0,
    "serve_drink": 5.0,
    "customer_payment": 0.02,
    "lost_customer": -80.0,
    "wrong_table": -6.0,
    "buy_upgrade": 1.0,
    "no_upgrade": -0.01,
    "win": 180.0,
    "trash": -1.0
  },

  "game_overrides": {
    "_comment": "첫 승리 경험 해금을 위해 목표 금액을 추가로 낮춤",
    "target_money": 100,
    "day_limit": 8
  }
}
