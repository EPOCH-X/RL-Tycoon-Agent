{
  "_comment": "PPO 전용 하이퍼파라미터. Stable-Baselines3 PPO 기반.",
  "algorithm": "PPO",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 200000,
    "n_envs": 8,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 1e-4,
    "n_steps": 4096,
    "batch_size": 256,
    "n_epochs": 10,
    "gamma": 0.995,
    "gae_lambda": 0.98,
    "clip_range": 0.2,
    "ent_coef": 0.05,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "network": {
    "net_arch": [256, 256],
    "activation_fn": "tanh"
  },

  "reward_shaping": {
    "take_order": 10.0,
    "serve_food": 20.0,
    "submit_kitchen": 5.0,
    "pickup_food": 5.0,
    "pickup_drink": 3.0,
    "serve_drink": 10.0,
    "customer_payment": 3.0,
    "lost_customer": -5.0,
    "wrong_table": -1.0,
    "buy_upgrade": 3.0,
    "no_upgrade": -0.05,
    "win": 500.0,
    "trash": 0.5,
    "game_end": 0.01
  },

  "game_overrides": {
    "target_money": null,
    "day_limit": null
  }
}
