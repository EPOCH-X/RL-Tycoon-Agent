{
  "algorithm": "CrossPlay",
  "description": "교차 알고리즘 자기 대결 학습 – 기존 모델을 선택하여 다른 모델들과 대결 추가학습",
  "training": {
    "total_timesteps": 2000000,
    "eval_freq": 5000,
    "seed": 42,
    "opponent_swap_freq": 10000,
    "n_eval_episodes": 5
  },
  "hyperparameters": {
    "learning_rate": 3e-4,
    "gamma": 0.99,
    "batch_size": 64,
    "n_steps": 2048,
    "n_epochs": 10,
    "clip_range": 0.2,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "n_envs": 4,
    "net_arch": [256, 256]
  },
  "game_overrides": {
    "target_money": 1500,
    "day_limit": 30
  },
  "reward_shaping": {
    "take_order": 5.0,
    "submit_kitchen": 4.0,
    "pickup_food": 4.0,
    "serve_food": 8.0,
    "pickup_drink": 2.0,
    "serve_drink": 4.0,
    "customer_payment": 1.0,
    "lost_customer": 0.0,
    "relative_money_bonus": 0.5,
    "relative_rating_bonus": 1.0
  }
}
