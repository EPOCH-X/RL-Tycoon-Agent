{
  "_comment": "SAC (Soft Actor-Critic) Discrete 전용 설정. sb3-contrib의 DiscreteSAC 사용 또는 SB3 SAC+wrapper.",
  "algorithm": "SAC",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 300000,
    "n_envs": 1,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 3e-4,
    "buffer_size": 100000,
    "learning_starts": 500,
    "batch_size": 256,
    "gamma": 0.99,
