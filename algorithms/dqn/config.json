{
  "_comment": "DQN 전용 하이퍼파라미터. Stable-Baselines3 DQN 기반. Discrete action에 적합.",
  "algorithm": "DQN",
  "policy": "MlpPolicy",

  "training": {
    "total_timesteps": 200000,
    "n_envs": 1,
    "seed": 42,
    "eval_freq": 5000
  },

  "hyperparameters": {
    "learning_rate": 1e-4,
    "buffer_size": 100000,
    "learning_starts": 1000,
    "batch_size": 64,
    "gamma": 0.99,
    "tau": 1.0,
    "target_update_interval": 1000,
    "train_freq": 4,
    "gradient_steps": 1,
    "exploration_fraction": 0.2,
    "exploration_initial_eps": 1.0,
    "exploration_final_eps": 0.05,
    "max_grad_norm": 10.0
  },

  "network": {
    "net_arch": [256, 256],
    "activation_fn": "relu"
  },

  "reward_shaping": {
    "take_order": 2.0,
    "serve_food": 5.0,
    "submit_kitchen": 1.0,
    "pickup_food": 1.0,
    "pickup_drink": 1.0,
    "serve_drink": 3.0,
    "customer_payment": 1.0,
    "lost_customer": -30.0,
    "wrong_table": -2.0,
    "buy_upgrade": 3.0,
    "no_upgrade": -0.1,
    "win": 200.0,
    "trash": 0.5,
    "game_end": 0.01
  },

  "game_overrides": {
    "target_money": null,
    "day_limit": null
  }
}
